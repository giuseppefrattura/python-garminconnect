{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 HTTP Traffic & Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_requests_seconds_count[1m])) or sum by (service_name) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Richieste al secondo (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Spring",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Spring",
          "refId": "B"
        }
      ],
      "title": "Latenza HTTP (p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m])) or sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "Stati di Risposta HTTP",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "☕ JVM Runtime (garmin-service)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", service_name=\"garmin-service\"}",
          "legendFormat": "Heap Usato",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", service_name=\"garmin-service\"}",
          "legendFormat": "Heap Max",
          "refId": "B"
        }
      ],
      "title": "Memoria JVM Heap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{service_name=\"garmin-service\"}[1m])",
          "legendFormat": "GC Pause Duration",
          "refId": "A"
        }
      ],
      "title": "Garbage Collection Pauses",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [
        {
          "expr": "jvm_threads_live_threads{service_name=\"garmin-service\"}",
          "legendFormat": "Thread Attivi",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_peak_threads{service_name=\"garmin-service\"}",
          "legendFormat": "Thread Picco",
          "refId": "B"
        }
      ],
      "title": "Thread JVM",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🗄️ Database HikariCP & Sicurezza",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "expr": "hikaricp_connections_active{service_name=\"garmin-service\"}",
          "legendFormat": "Attive",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{service_name=\"garmin-service\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{service_name=\"garmin-service\"}",
          "legendFormat": "In attesa",
          "refId": "C"
        }
      ],
      "title": "Connessioni HikariCP PostgreSQL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (category) (security_rate_limit_hits_total)",
          "legendFormat": "Blocchi {{category}}",
          "refId": "A"
        }
      ],
      "title": "Richieste Bloccate da Rate Limiter (HTTP 429)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "targets": [
        {
          "expr": "security_login_failures_total",
          "legendFormat": "Login Falliti",
          "refId": "A"
        }
      ],
      "title": "Tentativi di Login Falliti",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 103,
      "title": "📜 Log Centralizzati Docker (Grafana Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{container=~\"garmin-service|garmin-proxy|renpho-service|alloy\"} |= ``",
          "refId": "A"
        }
      ],
      "title": "Streaming Log Container in Tempo Reale",
      "type": "logs"
    }
  ],
  "refresh": "30s",
